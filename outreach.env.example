# Copy to outreach.env (gitignored). Real environment variables override these.
OUTREACH_SENDER=you@example.com            # the ONLY Gmail account allowed to draft/send
OUTREACH_SENDER_NAME="Your Name"
OUTREACH_RESUME=~/Documents/resume.pdf      # attached only for internship/referral asks
OUTREACH_TEST_RECIPIENT=you+test@example.com  # your own inbox, for `outreach test-send`
